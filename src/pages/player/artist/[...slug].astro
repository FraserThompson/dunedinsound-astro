---
import { loadAndFormatCollection, type PlayerAudio } from '@src/util/collection.ts'
import PlayerLayout from '@src/layouts/base/PlayerLayout.astro'
import { artistPlayerThreshold } from '@src/util/constants'
import path from 'path'

export async function getStaticPaths() {
	const entries = await loadAndFormatCollection('artist')
	return Promise.all(
		entries
			.filter((entry) => entry.extra.gigCount > artistPlayerThreshold)
			.map(async (entry) => {
				return {
					params: { slug: entry.extra.slug },
					props: {
						entry
					}
				}
			})
	)
}

let audioFromGigs: PlayerAudio[] = []

const { entry } = Astro.props

if (entry) {
	// Find related gigs and sort them
	const gigs = await loadAndFormatCollection(
		'gig',
		(thing) => !!thing.entry.data.artists?.find((artist) => artist.id.id === entry.entry.id)
	)

	audioFromGigs = gigs.reduce((acc, gig) => {
		const audio = gig.extra.media.audio
			.filter((audio) => audio.artist?.id === entry.entry.id)
			.map((audio) => {
				const title = path.basename(audio.files[0])
				return {
					...audio,
					title
				}
			})
		return [...acc, ...audio]
	}, [] as PlayerAudio[])

	const vaultsessions = await loadAndFormatCollection(
		'vaultsession',
		(thing) => thing.entry.data.artist.id === entry.entry.id
	)

	if (vaultsessions.length) {
		const vaultSeshAudio = vaultsessions[0].extra.audio
		const title = path.basename(vaultSeshAudio.files[0])
		audioFromGigs.push({
			...vaultSeshAudio,
			title
		})
	}
}
---

<PlayerLayout audioFromGigs={audioFromGigs} gigsFromEntry={entry} />
