---
/**
 * A layout with a player for playing one artists audio.
 *
 * Props:
 *  - audioFromGigs: Array of PlayerAudio elements to put in the playlist
 *  - gigsFromEntry: The Entry which the gigs are from (optional)
 */
import { loadAndFormatCollection, type PlayerAudio, type ProcessedEntry } from '@src/util/collection'
import LibraryPlayer from '@src/components/LibraryPlayer'
import ImageGallery from '@src/components/ImageGallery.astro'
import BaseLayout from '@src/layouts/base/BaseLayout.astro'
import PersistentWaveformSlot from '@src/components/player/PersistentWaveformSlot.astro'
import { artistPlayerThreshold, seriesVenuePlayerThreshold } from '@src/util/constants'
import LoadingSpinner from '@src/components/LoadingSpinner'
import { PlayerLibraryActionBar } from '@src/components/player/PlayerLibrary.css'

interface Props {
	audioFromGigs?: PlayerAudio[]
	gigsFromEntry?: ProcessedEntry<'artist'> | ProcessedEntry<'venue'> | ProcessedEntry<'series'>
}

const { gigsFromEntry, audioFromGigs } = Astro.props

const artists = await loadAndFormatCollection('artist', (entry) => entry.extra.gigCount > artistPlayerThreshold)
const venues = await loadAndFormatCollection('venue', (entry) => entry.extra.gigCount > seriesVenuePlayerThreshold)
const gigs = await loadAndFormatCollection('gig')
const vaultsessions = await loadAndFormatCollection('vaultsession')

// List of artists for artist selector
const artistOptions = artists.map((entry) => ({
	id: entry.entry.id,
	title: entry.entry.data.title,
	count: entry.extra.gigCount
}))

// List of venues for venues selector
const venueOptions = venues.map((entry) => ({
	id: entry.entry.id,
	title: entry.entry.data.title,
	count: entry.extra.gigCount
}))

// Full list of library items, minimal since it goes in as a data-attribute
const libraryItems: PlayerAudio[] = [
	...gigs.flatMap((gigEntry) => gigEntry.extra.media.audio),
	...vaultsessions.flatMap((session) => [session.extra.audio])
]

const initialArtistId = gigsFromEntry?.entry.collection === 'artist' ? gigsFromEntry.entry.id : undefined
const initialVenueId = gigsFromEntry?.entry.collection === 'venue' ? gigsFromEntry.entry.id : undefined
---

<BaseLayout
	hideFooter={true}
	poo={{
		title: gigsFromEntry ? `${gigsFromEntry.entry.data.title} Player` : 'Player',
		description: gigsFromEntry ? `Play audio bootlages from ${gigsFromEntry.entry.data.title}.` : 'Audio player'
	}}
>
	<LibraryPlayer
		title={`PLAYER`}
		playerAudio={audioFromGigs}
		playerAudio={libraryItems}
		artistOptions={artistOptions}
		venueOptions={venueOptions}
		initialArtistId={initialArtistId}
		initialVenueId={initialVenueId}
		client:only="preact"
	>
		<div slot="fallback">
			<div style={{ position: 'fixed', width: '100vw', height: '100vh', overflow: 'hidden' }}>
				<LoadingSpinner />
			</div>
		</div>
		<PersistentWaveformSlot slot="waveform" hideMobile={true}/>
		<ImageGallery thumbnailWidthDesktop="250px" enableClientUpdates={true} />
		<div
			id="gig-meta"
			slot="footer"
			class={PlayerLibraryActionBar}
			data-artist={gigsFromEntry && gigsFromEntry.entry.collection === 'artist' ? gigsFromEntry.entry.id : 'index'}
			data-gig={''}
		>
		</div>
	</LibraryPlayer>
</BaseLayout>

<script>
	import { WinampInset } from '@src/components/player/PlayerTracklist.css'
	import { TransportButton } from '@src/components/player/PlayerTransport.css'
	import {
		imageGalleryUpdateEventName,
		playerLibraryPreviewEventName,
		type ImageGalleryUpdateEventDetails,
		type PlayerLibraryPreviewEventDetails
	} from '@src/util/events'

	import { getEntryPath, type ArtistGigResponse } from '@src/util/helpers'
	import { formattedDate } from '@src/util/names'

	let playerStateUnsubscribe: (() => void) | undefined
	let libraryPreviewSelection: PlayerLibraryPreviewEventDetails | undefined
	let lastRenderedPreviewKey: string | undefined

	const updateFromSelection = async (selection?: PlayerLibraryPreviewEventDetails) => {
		const artistId = selection?.artist.id
		const gigId = selection?.gig.id

		if (!gigId) return

		const previewKey = `${gigId}|${artistId || ''}`
		if (previewKey === lastRenderedPreviewKey) return
		lastRenderedPreviewKey = previewKey

		let req: Response
		try {
			req = await fetch(`/data/gigs/${gigId}/${artistId}.json`)
		} catch (error) {
			if (error instanceof DOMException && error.name === 'AbortError') {
				return
			}
			throw error
		}

		if (req.ok) {
			const json: ArtistGigResponse = await req.json()

			if (json.images) {
				// Give images to the image gallery
				const detail: ImageGalleryUpdateEventDetails = {
					images: json.images
				}
				const event = new CustomEvent(imageGalleryUpdateEventName, {
					detail
				})
				window.dispatchEvent(event)
			}

			const metaContainer: HTMLElement | null = document.querySelector('#gig-meta')
			if (!metaContainer) return

			const gig = json.data

			metaContainer.dataset.gig = gigId
			metaContainer.innerHTML = `
				<a class='${TransportButton} clear' href="${getEntryPath(gig.data.title, 'gig')}">
					GO TO GIG PAGE
				</a>
				<span class='${WinampInset}' style="color: #28da1d; font-family: monospace; font-size: 12px; margin-left: auto;">
					${formattedDate(new Date(gig.data.date))}
				<span>
			`
		}
	}

	const onLibraryPreviewSelection = async (event: Event) => {
		const customEvent = event as CustomEvent<PlayerLibraryPreviewEventDetails>
		libraryPreviewSelection = customEvent.detail
		await updateFromSelection(libraryPreviewSelection)
	}

	const init = () => {
		playerStateUnsubscribe?.()
		window.removeEventListener(playerLibraryPreviewEventName, onLibraryPreviewSelection as EventListener)
		window.addEventListener(playerLibraryPreviewEventName, onLibraryPreviewSelection as EventListener)
	}

	const cleanup = () => {
		window.removeEventListener(playerLibraryPreviewEventName, onLibraryPreviewSelection as EventListener)
	}

	document.removeEventListener('astro:page-load', init)
	document.addEventListener('astro:page-load', init)
	document.removeEventListener('astro:before-swap', cleanup)
	document.addEventListener('astro:before-swap', cleanup)
</script>
