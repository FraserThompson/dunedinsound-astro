---
import TextContainer from '@src/components/TextContainer.astro'
import { type ProcessedEntry } from '@src/util/collection.ts'
import type { ResponsiveImage } from '@src/util/ResponsiveImage'
import Banner from '@src/components/Banner.astro'
import BlogSidebar from '@src/components/blog/BlogSidebar.astro'
import BlogTile from '@src/components/blog/BlogTile.astro'
import FlexGridContainer from '@src/components/FlexGridContainer.astro'
import GigTile from '@src/components/gig/GigTile.astro'
import CompactPlayer from '@src/components/CompactPlayer'
import Image from '@src/components/LightboxImage.astro'
import SidebarNav from '@src/components/SidebarNav.astro'
import ChevronLeftIcon from '~icons/iconoir/nav-arrow-left'
import { backButton } from '@src/components/gig/GigsMenu.css'
import ImageGalleryLightbox from '@src/components/ImageGalleryLightbox.astro'
import ImageGallery from '@src/components/ImageGallery.astro'
import ShareButton from '@src/components/ShareButton.astro'
import { BlogTextContainer, BlogPageContainer, VideoCover } from './Blog.css'
import { render } from 'astro:content'
import DropdownMenu from '@src/components/DropdownMenu.astro'
import generateToc from '@src/util/toc'

interface Props {
	entry: ProcessedEntry<'blog'>
	images?: { [id: string]: ResponsiveImage }
}
const { entry, images } = Astro.props

const { Content, headings } = await render(entry.entry)
const toc = generateToc(headings)

const entryData = entry.entry.data
const entryExtra = entry.extra
---

{
	entryExtra.cover && !entryExtra.coverVid && (
		<Banner backgroundImage={entryExtra.cover} backgroundImageVertical={entryExtra.coverVertical}>
			<h1 slot="subtitle" style={{ textShadow: 'none' }}>
				{entryData.title}
			</h1>
			<ShareButton
				style={{ position: 'absolute', left: '50%', transform: 'translate(-50%)' }}
				shareData={{
					title: 'ARTICLE: ' + entryData.title,
					url: 'https://dunedinsound.com' + entryExtra.slug,
					text: `${entryData.description}.`
				}}
			/>
		</Banner>
	)
}
{
	entryExtra.coverVid && (
		<Banner title={entryData.title}>
			<div slot="customContent">
				<video src={entryExtra.coverVid} autoplay={true} loop={true} muted={true} class={VideoCover} />
			</div>
			<ShareButton
				style={{ position: 'absolute', left: '50%', transform: 'translate(-50%)' }}
				shareData={{
					title: 'ARTICLE: ' + entryData.title,
					url: 'https://dunedinsound.com' + entryExtra.slug,
					text: `${entryData.description}.`
				}}
			/>
		</Banner>
	)
}
{
	entryData.stickyHeaders && (
		<DropdownMenu
			className="showMobile block"
			direction="down"
			buttonWidth="100%"
			backgroundColor="white"
			textColor="black"
			buttonHeight="45px"
			highlightOnScroll={true}
			width="100%"
			list={toc.map((heading) => ({
				title: heading.text,
				href: `#${heading.slug}`
			}))}
		/>
	)
}
<div class={BlogPageContainer} id="overview">
	<div style={{ maxWidth: '1600px', margin: '0 auto', display: 'flex' }}>
		<BlogSidebar className="hideMobile" entry={entry} toc={toc} />
		<div class={BlogTextContainer}>
			<TextContainer light={true} stickyHeaders={entry.entry.data.stickyHeaders}>
				<Content components={{ CompactPlayer, Image }} />
			</TextContainer>
		</div>
	</div>
</div>
<div class="showMobile">
	<SidebarNav customButton={true}>
		<BlogSidebar slot="sidebarMenu" entry={entry} toc={toc} />
		<a slot="sidebarSubheaderTopMobile" class={`showMobile flex ${backButton}`} href="/blog">
			<ChevronLeftIcon /> Go to articles home
		</a>
	</SidebarNav>
</div>
{entryData.gallery && images && <ImageGallery images={Object.values(images)} />}
<div style={{ maxWidth: '1100px', margin: '0 auto' }}>
	{!!entryExtra.relatedBlogs?.length && <h2>Related articles...</h2>}
</div>
{
	!!entryExtra.relatedBlogs?.length && (
		<FlexGridContainer>
			{entryExtra.relatedBlogs.map((relatedBlog) => (
				<BlogTile blog={relatedBlog} responsiveImageSizes={'grid'} backgroundStyle="center" />
			))}
		</FlexGridContainer>
	)
}
<div style={{ maxWidth: '1100px', margin: '0 auto' }}>
	{!!entryExtra.relatedGigs?.length && <h2>Related gigs...</h2>}
</div>
{
	!!entryExtra.relatedGigs?.length && (
		<FlexGridContainer>
			{entryExtra.relatedGigs.map((entry) => (
				<GigTile gig={entry} />
			))}
		</FlexGridContainer>
	)
}
{images && <ImageGalleryLightbox />}
