---
/**
 * We use lightgallery pretty much as is, this component just
 * updates the URL on image change, and opens the corresponding
 * image so people can link directly to images.
 *
 * Also responds to {imageGalleryUpdatedEventName} to trigger a refresh.
 */
import 'lightgallery/css/lightgallery.css'
import 'lightgallery/css/lg-zoom.css'

interface Props {
	disableUrlUpdates?: boolean
}

const { disableUrlUpdates } = Astro.props
---

<image-gallery-lightbox data-disable-url-updates={disableUrlUpdates ? 'true' : 'false'} hidden></image-gallery-lightbox>

<script>
	import lightGallery from 'lightgallery'
	import lgZoom from 'lightgallery/plugins/zoom'
	import { navigate } from 'astro:transitions/client'
	import { imageGalleryUpdatedEventName } from '@src/util/events'
	import type { LightGallery } from '@node_modules/lightgallery/lightgallery'

	class ImageGalleryLightbox extends HTMLElement {
		lightbox: LightGallery | null = null
		activeIndex = 0
		lightboxClosedByBack = false
		disableUrlUpdates = false

		onGalleryUpdated = () => {
			this.lightbox?.refresh()
			if (this.disableUrlUpdates && this.lightbox?.lgOpened) {
				this.lightbox.slide(this.activeIndex, false, false)
			}
		}

		onAfterSlide = (e: any) => {
			this.activeIndex = e.detail.index
		}

		onBeforeSlide = (e: any) => {
			const { index, prevIndex } = e.detail
			this.activeIndex = index
			if (prevIndex === index) {
				navigate(`#image=${index}`, { history: 'push' })
			} else {
				navigate(`#image=${index}`, { history: 'replace' })
			}
		}

		onAfterClose = () => {
			if (this.lightboxClosedByBack) {
				this.lightboxClosedByBack = false
				return
			}

			if (window.history.state.index > 0) {
				window.history.back()
			} else {
				navigate(``, { history: 'replace' })
			}
		}

		onPopState = () => {
			if (!location.hash.includes('image') && this.lightbox?.lgOpened) {
				this.lightboxClosedByBack = true
				this.lightbox.closeGallery()
			}
		}

		connectedCallback() {
			this.disableUrlUpdates = this.dataset.disableUrlUpdates === 'true'

			const options = {
				selector: '.lightboxImage',
				plugins: [lgZoom],
				hideScrollbar: true,
				speed: 300,
				mobileSettings: { controls: false, showCloseIcon: true, download: true }
			}

			this.lightbox = lightGallery(document.body, { ...options })

			const hash = window.location.hash
			if (hash.includes('image=')) {
				const imageIndex = parseInt(hash.split('=')[1])
				this.activeIndex = imageIndex
				this.lightbox.openGallery(imageIndex)
			}

			document.addEventListener(imageGalleryUpdatedEventName, this.onGalleryUpdated)
			document.body?.addEventListener('lgAfterSlide', this.onAfterSlide)

			if (!this.disableUrlUpdates) {
				document.body?.addEventListener('lgBeforeSlide', this.onBeforeSlide)
				document.body?.addEventListener('lgAfterClose', this.onAfterClose)
				window.addEventListener('popstate', this.onPopState)
			}
		}

		disconnectedCallback() {
			document.removeEventListener(imageGalleryUpdatedEventName, this.onGalleryUpdated)
			document.body?.removeEventListener('lgAfterSlide', this.onAfterSlide)
			document.body?.removeEventListener('lgBeforeSlide', this.onBeforeSlide)
			document.body?.removeEventListener('lgAfterClose', this.onAfterClose)
			window.removeEventListener('popstate', this.onPopState)
			this.lightbox?.destroy?.()
			this.lightbox = null
			this.lightboxClosedByBack = false
		}
	}

	if (!customElements.get('image-gallery-lightbox')) {
		customElements.define('image-gallery-lightbox', ImageGalleryLightbox)
	}
</script>
