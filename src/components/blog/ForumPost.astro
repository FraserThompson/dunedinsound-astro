---
interface Props {
	username: string
	userTitle?: string
	admin?: boolean
	signature?: string
	threadTitle?: string
	postDate: string
	postCount: string | number
	joinedDate: string
	location?: string
}

const { username, userTitle, admin, signature, threadTitle, postDate, postCount, joinedDate, location } = Astro.props
---

<article class="forum-post-prosilver">
	<section class="post-main-content">
		{threadTitle && <span class="thread-title">{threadTitle}</span>}
		<header class="post-header">
			<span class="post-icon" aria-hidden="true">📄</span>
			<span class="header-text">
				by <strong class="author-highlight">{username}</strong> on {postDate}
			</span>
		</header>

		<div class="post-body">
			<slot />
			{
				signature && (
					<>
						<hr />
						<p>{signature}</p>
					</>
				)
			}
		</div>
	</section>

	<aside class="profile-sidebar">
		<div class="profile-details">
			<h3 class=`profile-username ${admin ? 'is-admin' : ''}`>{username}</h3>
			{userTitle && <p class="profile-rank">{userTitle}</p>}

			<dl class="profile-stats">
				<div>
					<dt>Posts:</dt>
					<dd>{postCount}</dd>
				</div>
				<div>
					<dt>Joined:</dt>
					<dd>{joinedDate}</dd>
				</div>
				{
					location && (
						<div>
							<dt>Location: </dt>
							<dd>{location}</dd>
						</div>
					)
				}
			</dl>
		</div>
	</aside>
</article>

<style>
	/* Core Container & Layout mimicking phpBB3 Prosilver */
	.forum-post-prosilver {
		padding: 0px !important;
		font-family: 'Verdana', 'Helvetica', 'Arial', sans-serif;
		background-color: #ecf3f7;
		border: 1px solid #cadceb;
		border-radius: 7px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 190px;
		color: #333333;
		margin-bottom: 1.25rem;
		box-sizing: border-box;
		overflow: hidden;
		margin-bottom: 4px !important;
	}

	/* Main Post Content Layout */
	.post-main-content {
		padding: 10px 12px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		position: relative;
		min-width: 0;
	}

	.post-header {
		margin: 0 !important;
		padding: 0px 10px !important;
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.post-icon {
		font-size: 10px;
		opacity: 0.6;
	}

	.author-highlight {
		color: #943130;
		font-weight: bold;
	}

	.thread-title {
		width: 100%;
		padding-bottom: 0px !important;
		color: #943130;
		font-weight: bold;
		font-size: 20px;
		overflow-wrap: anywhere;
	}

	.post-body {
		flex-grow: 1;
		width: 100%;
		box-sizing: border-box;
		padding-top: 0 !important;
		padding-bottom: 0 !important;
		color: #333333;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.profile-sidebar {
		padding: 10px 10px 10px 15px;
		border-left: 1px solid #ffffff;
		font-size: 11px;
		color: #666666;
	}

	.profile-username {
		font-size: 12px;
		font-weight: normal;
		margin: 0 0 2px 0;
		color: #105289;
		&.is-admin {
			color: #aa0000;
		}
	}

	.profile-rank {
		font-size: 12px;
		line-height: 1.2;
		margin: 0 0 1.2em 0;
		color: #666666;
	}

	.profile-stats {
		margin: 0;
		padding: 0;
		line-height: 1.2;
	}

	.profile-stats div {
		margin-bottom: 2px;
	}

	.profile-stats dt {
		display: inline;
		color: black;
	}

	.profile-stats dd {
		display: inline;
		margin: 0;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	/* Responsive Mobile Layout Override */
	@media (max-width: 920px) {
		.forum-post-prosilver {
			grid-template-columns: 1fr;
		}

		.profile-sidebar {
			border-left: none;
			border-top: 1px solid #ffffff;
			display: flex;
			gap: 15px;
			align-items: center;
		}

		.top-button {
			display: none; /* Hide button layout clutter on small mobile viewports */
		}
	}
</style>

<style is:global>
	.post-body p,
	.post-body ul {
		line-height: 16.8px !important;
		font-size: 12px !important;
		margin: 0 0 10px 0;
		font-family: Verdana, Helvetica, Arial, sans-serif !important;
	}
	.post-body .quote-content {
		background-color: transparent !important;
	}
	.post-header span {
		font-size: 12px !important;
	}
</style>
